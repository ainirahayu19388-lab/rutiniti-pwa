            </div>

            <div class="glass-card p-6 rounded-2xl border border-slate-200/80 dark:border-slate-800 md:col-span-2 space-y-5">

                <h3 class="font-bold text-base flex items-center gap-2">

                    <i class="fa-solid fa-chart-line text-indigo-400"></i> Analisis Istirahat & Kesehatan

                </h3>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">

                    <div class="p-4 rounded-2xl bg-indigo-50/50 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900/40">

                        <span class="block text-\[11px\] text-slate-500">Durasi Tidur Semalam</span>

                        <span class="text-xl font-extrabold text-indigo-600 dark:text-indigo-300" id="sleep-duration-val">0 Jam</span>

                    </div>

                    <div class="p-4 rounded-2xl bg-indigo-50/50 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900/40">

                        <span class="block text-\[11px\] text-slate-500">Status Target (7-8 Jam)</span>

                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200" id="sleep-status-tag">Belum Dicatat</span>

                    </div>

                    <div class="p-4 rounded-2xl bg-indigo-50/50 dark:bg-indigo-950/30 border border-indigo-100 dark:border-indigo-900/40 col-span-2 sm:col-span-1">

                        <span class="block text-\[11px\] text-slate-500">Kualitas</span>

                        <span class="text-xs font-bold text-slate-700 dark:text-slate-200" id="sleep-quality-tag">-</span>

                    </div>

                </div>

                <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50 space-y-2 text-xs">

                    <h4 class="font-bold flex items-center gap-1.5 text-indigo-500">

                        <i class="fa-solid fa-lightbulb"></i> Tips Tidur Berkualitas untuk Remaja & Pelajar:

                    </h4>

                    <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-400">

                        <li>Matikan atau jauhkan smartphone 30 menit sebelum tidur.</li>

                        <li>Usahakan jadwal tidur konsisten di jam yang sama setiap malam (misal: 21:30 WIB).</li>

                        <li>Hindari minuman berkafein atau makanan berat menjelang jam tidur.</li>

                    </ul>

                </div>

            </div>

        </div>

    </section>

</main>

<div id="routine-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm hidden">

    <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full mx-4 p-6 shadow-xl border border-slate-200 dark:border-slate-700 space-y-5">

        <div class="flex items-center justify-between border-b pb-3 dark:border-slate-700">

            <h3 class="text-lg font-bold text-slate-800 dark:text-white" id="modal-title">Tambah Kegiatan Baru</h3>

            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white text-lg">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

        <form id="routine-form" class="space-y-4">

            <input type="hidden" id="form-routine-id" value="">

            <div>

                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">Nama Kegiatan / PR / Tugas</label>

                <input type="text" id="form-title" required placeholder="Contoh: PR Matematika Bab 3 atau Lari Pagi" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">

            </div>

            <div class="grid grid-cols-2 gap-3">

                <div>

                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">Sesi / Kategori</label>

                    <select id="form-category" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">

                        <option value="pagi">🌅 Pagi</option>

                        <option value="siang">☀️ Siang</option>

                        <option value="malam">🌙 Malam</option>

                        <option value="pr">📚 Belajar & PR</option>

                    </select>

                </div>

                <div>

                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">Target Jam</label>

                    <input type="time" id="form-time" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">

                </div>

            </div>

            <div>

                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-1">Durasi Mode Fokus (Menit)</label>

                <input type="number" id="form-duration" min="0" max="300" placeholder="0 (Tanpa timer)" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">

            </div>

            <div class="flex justify-end space-x-3 pt-3 border-t dark:border-slate-700">

                <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl text-slate-600 dark:text-slate-300 text-sm font-semibold hover:bg-slate-100 dark:hover:bg-slate-700">Batal</button>

                <button type="submit" class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-md">Simpan Kegiatan</button>

            </div>

        </form>

    </div>

</div>

<div id="timer-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/70 backdrop-blur-md hidden">

    <div class="bg-white dark:bg-slate-800 rounded-3xl max-w-sm w-full mx-4 p-8 shadow-2xl border border-slate-200 dark:border-slate-700 text-center space-y-6">

        <div class="flex justify-between items-center">

            <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400">Mode Belajar / Fokus</span>

            <button onclick="closeTimerModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white">

                <i class="fa-solid fa-xmark text-lg"></i>

            </button>

        </div>

        <h3 class="text-lg font-bold text-slate-800 dark:text-white" id="timer-routine-title">Mengerjakan PR</h3>

        <div class="relative w-48 h-48 mx-auto flex items-center justify-center rounded-full bg-emerald-50 dark:bg-slate-900 border-4 border-emerald-500">

            <div class="text-4xl font-extrabold text-slate-800 dark:text-white tracking-tight" id="timer-display">

                25:00

            </div>

        </div>

        <div class="flex justify-center items-center space-x-4">

            <button id="btn-timer-toggle" onclick="toggleTimer()" class="w-14 h-14 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center text-xl shadow-lg shadow-emerald-600/30 transition-all">

                <i class="fa-solid fa-play ml-1" id="timer-icon"></i>

            </button>

            <button onclick="resetTimer()" class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center text-lg hover:bg-slate-200">

                <i class="fa-solid fa-rotate-left"></i>

            </button>

        </div>

        <button onclick="completeTimerRoutine()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-sm shadow-md">

            <i class="fa-solid fa-check mr-2"></i>Tandai Selesai & Tutup

        </button>

    </div>

</div>

<!-- Notification Toast Container -->

<div id="toast-container" class="fixed bottom-5 right-5 z-50 space-y-2 pointer-events-none"></div>

<script>

    const defaultRoutines = \[

        { id: '1', title: 'Sholat Pagi / Meditasi & Air Putih', category: 'pagi', time: '05:00', duration: 10 },

        { id: '2', title: 'Jogging Ringan / Lari Pagi 15 Menit', category: 'pagi', time: '06:00', duration: 15 },

        { id: '3', title: 'Sarapan Sehat (Telur/Oatmeal)', category: 'pagi', time: '06:45', duration: 0 },

        { id: '4', title: 'Belajar Sesi Siang / PR Sekolah', category: 'pr', time: '14:00', duration: 45 },

        { id: '5', title: 'Makan Malam & Istirahat', category: 'malam', time: '18:30', duration: 0 },

        { id: '6', title: 'Review Pelajaran & Membaca Buku', category: 'pr', time: '19:30', duration: 30 },

        { id: '7', title: 'Persiapan Tidur & Matikan Gadget', category: 'malam', time: '21:30', duration: 0 }

    \];

    let routines = \[\];

    let logs = {}; 

    let waterIntake = 0;

    let meals = { breakfast: '', lunch: '', dinner: '' };

    let workoutHistory = \[\];

    let sleepData = { duration: 0, quality: '', status: 'Belum Dicatat' };

    let selectedDate = getTodayDateString();

    let activeFilter = 'all';

    let runTimerInterval = null;

    let runSeconds = 0;

    let isRunning = false;

    let timerInterval = null;

    let timerSecondsRemaining = 0;

    let isTimerRunning = false;

    let activeTimerRoutineId = null;

    document.addEventListener('DOMContentLoaded', () => {

        loadTheme();

        loadLocalData();

        document.getElementById('date-picker').value = selectedDate;

        updateDateHeaderDisplay();

        setupNavigationTabs();

        renderRoutines();

        updateStatistics();

        renderFoodRecommendations();

        renderWorkoutHistory();

        checkNotificationsAndAlerts();

        setInterval(checkNotificationsAndAlerts, 30000);

        setupEventListeners();

        if ('serviceWorker' in navigator) {

            navigator.serviceWorker.register('./sw.js')

                .then(() => console.log('PWA Service Worker terdaftar!'))

                .catch((err) => console.log('Gagal daftar SW:', err));

        }

    });

    function getTodayDateString() {

        return new Date().toISOString().split('T')\[0\];

    }

    function formatDateIndonesian(dateStr) {

        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };

        return new Date(dateStr + 'T00:00:00').toLocaleDateString('id-ID', options);

    }

    function loadLocalData() {

        const savedRoutines = localStorage.getItem('rutiniti_plus_routines');

        const savedLogs = localStorage.getItem('rutiniti_plus_logs');

        const savedWater = localStorage.getItem('rutiniti_water\_' + selectedDate);

        const savedMeals = localStorage.getItem('rutiniti_meals\_' + selectedDate);

        const savedWorkout = localStorage.getItem('rutiniti_workouts');

        const savedSleep = localStorage.getItem('rutiniti_sleep\_' + selectedDate);

        routines = savedRoutines ? JSON.parse(savedRoutines) : \[...defaultRoutines\];

        logs = savedLogs ? JSON.parse(savedLogs) : {};

        waterIntake = savedWater ? parseInt(savedWater) : 0;

        meals = savedMeals ? JSON.parse(savedMeals) : { breakfast: '', lunch: '', dinner: '' };

        workoutHistory = savedWorkout ? JSON.parse(savedWorkout) : \[\];

        sleepData = savedSleep ? JSON.parse(savedSleep) : { duration: 0, quality: '', status: 'Belum Dicatat' };

        updateWaterUI();

        updateMealsUI();

        updateSleepUI();

    }

    function saveRoutines() {

        localStorage.setItem('rutiniti_plus_routines', JSON.stringify(routines));

        syncWithGoogleAppsScript();

    }

    function saveLogs() {

        localStorage.setItem('rutiniti_plus_logs', JSON.stringify(logs));

        syncWithGoogleAppsScript();

    }

    function loadTheme() {

        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {

            document.documentElement.classList.add('dark');

        } else {

            document.documentElement.classList.remove('dark');

        }

    }

    function setupNavigationTabs() {

        document.querySelectorAll('.nav-tab').forEach(tab => {

            tab.addEventListener('click', () => {

                const target = tab.dataset.tab;

                switchTab(target);

            });

        });

    }

    function switchTab(tabId) {

        document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));

        document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));

        const activeTab = document.querySelector(\`\[data-tab="\${tabId}"\]\`);

        if (activeTab) activeTab.classList.add('active');

        const content = document.getElementById(tabId);

        if (content) content.classList.remove('hidden');

    }

    function renderRoutines() {

        const container = document.getElementById('routine-list-container');

        const emptyState = document.getElementById('empty-state');

        container.innerHTML = '';

        if (!logs\[selectedDate\]) logs\[selectedDate\] = {};

        const filtered = routines.filter(r => {

            if (activeFilter === 'all') return true;

            return r.category === activeFilter;

        });

        if (filtered.length === 0) {

            emptyState.classList.remove('hidden');

        } else {

            emptyState.classList.add('hidden');

        }

        filtered.forEach(routine => {

            const isCompleted = !!logs\[selectedDate\]\[routine.id\];

            const card = document.createElement('div');

            card.className = \`task-card glass-card rounded-2xl p-4 shadow-sm border \${

                isCompleted ? 'border-emerald-300 dark:border-emerald-800 bg-emerald-50/40 dark:bg-emerald-950/20' : 'border-slate-200/80 dark:border-slate-800'

            } flex items-center justify-between gap-4\`;

            card.innerHTML = \`

                <div class="flex items-center space-x-3.5 flex-1 min-w-0">

                    <button onclick="toggleRoutineStatus('\${routine.id}')" class="w-7 h-7 rounded-lg flex items-center justify-center transition-all ${

                        isCompleted ? 'bg-emerald-600 text-white shadow-md' : 'border-2 border-slate-300 dark:border-slate-600 hover:border-emerald-500'

                    }">

                        <i class="fa-solid fa-check text-xs \${isCompleted ? 'block' : 'hidden'}"></i>

                    </button>

                    <div class="min-w-0 flex-1">

                        <h4 class="font-semibold text-sm tracking-tight truncate \${isCompleted ? 'line-through text-slate-400' : 'text-slate-800 dark:text-slate-100'}">

                            \${escapeHtml(routine.title)}

                        </h4>

                        <div class="flex items-center space-x-2 mt-0.5 text-\[11px\] text-slate-500">

                            <span class="capitalize px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800">

                                \${getCategoryIcon(routine.category)} ${routine.category}

                            </span>

                            \${routine.time ? \`<span><i class="fa-regular fa-clock mr-1"></i>${routine.time}</span>\` : ''}

                            \${routine.duration ? \`<span><i class="fa-solid fa-stopwatch mr-1"></i>${routine.duration}m</span>\` : ''}

                        </div>

                    </div>

                </div>

                <div class="flex items-center space-x-1">

                    \${routine.duration ? \`

                        <button onclick="openTimerModal('\${routine.id}')" class="p-2 rounded-xl text-slate-400 hover:text-emerald-600 transition-colors" title="Buka Mode Fokus">

                            <i class="fa-solid fa-play text-xs"></i>

                        </button>

                    \` : ''}

                    <button onclick="deleteRoutine('\${routine.id}')" class="p-2 rounded-xl text-slate-400 hover:text-rose-600 transition-colors" title="Hapus">

                        <i class="fa-solid fa-trash-can text-xs"></i>

                    </button>

                </div>

            \`;

            container.appendChild(card);

        });

    }

    function updateStatistics() {

        const total = routines.length;

        const completedToday = Object.values(logs\[selectedDate\] || {}).filter(Boolean).length;

        const percent = total > 0 ? Math.round((completedToday / total) \* 100) : 0;

        document.getElementById('stat-percent').textContent = \`\${percent}%\`;

        document.getElementById('stat-count').textContent = \`(\${completedToday}/${total})\`;

        document.getElementById('stat-progress-bar').style.width = \`\${percent}%\`;

        const homeworkTotal = routines.filter(r => r.category === 'pr').length;

        const homeworkDone = routines.filter(r => r.category === 'pr' && logs\[selectedDate\]?.\[r.id\]).length;

        document.getElementById('stat-homework').textContent = \`\${homeworkTotal - homeworkDone} Belum\`;

        document.getElementById('stat-streak').textContent = calculateStreak();

        if (percent === 100 && total > 0 && !logs\[selectedDate\]?.celebrated) {

            triggerConfetti();

            logs\[selectedDate\].celebrated = true;

            saveLogs();

            showToast("🎉 Luar biasa! Semua kegiatan hari ini selesai!");

        }

    }

    function calculateStreak() {

        let streak = 0;

        let checkDate = new Date();

        while (true) {

            const dateKey = checkDate.toISOString().split('T')\[0\];

            const dayLog = logs\[dateKey\];

            const total = routines.length;

            const completedCount = Object.values(dayLog || {}).filter(Boolean).length;

            if (total > 0 && completedCount === total) {

                streak++;

                checkDate.setDate(checkDate.getDate() - 1);

            } else if (dateKey === getTodayDateString()) {

                checkDate.setDate(checkDate.getDate() - 1);

            } else {

                break;

            }

        }

        return streak;

    }

    function checkNotificationsAndAlerts() {

        const now = new Date();

        const currentHM = \`\${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}\`;

        let overdueCount = 0;

        routines.forEach(r => {

            const isDone = logs\[selectedDate\]?.\[r.id\];

            if (!isDone && r.time && r.time < currentHM) {

                overdueCount++;

            }

        });

        const banner = document.getElementById('overdue-banner');

        if (overdueCount > 0 && selectedDate === getTodayDateString()) {

            banner.classList.remove('hidden');

            document.getElementById('overdue-banner-text').textContent = \`Ada \${overdueCount} kegiatan terjadwal yang belum kamu selesaikan hari ini.\`;

        } else {

            banner.classList.add('hidden');

        }

    }

    function addWater(amount) {

        waterIntake = Math.min(waterIntake + amount, 3000);

        localStorage.setItem('rutiniti_water\_' + selectedDate, waterIntake);

        updateWaterUI();

        showToast(\`Minum \${amount} ml dicatat!\`);

    }

    function resetWater() {

        waterIntake = 0;

        localStorage.setItem('rutiniti_water\_' + selectedDate, 0);

        updateWaterUI();

    }

    function updateWaterUI() {

        document.getElementById('water-text').textContent = \`\${waterIntake} / 2000 ml\`;

        const percent = Math.min(Math.round((waterIntake / 2000) \* 100), 100);

        document.getElementById('water-bar').style.width = \`\${percent}%\`;

    }

    function openAddMealModal() {

        const breakfast = prompt("Sarapan hari ini:", meals.breakfast || "") || meals.breakfast;

        const lunch = prompt("Makan siang hari ini:", meals.lunch || "") || meals.lunch;

        const dinner = prompt("Makan malam hari ini:", meals.dinner || "") || meals.dinner;

        meals = { breakfast, lunch, dinner };

        localStorage.setItem('rutiniti_meals\_' + selectedDate, JSON.stringify(meals));

        updateMealsUI();

        showToast("Catatan makanan berhasil diperbarui!");

    }

    function updateMealsUI() {

        document.getElementById('meal-summary-breakfast').textContent = meals.breakfast || '-';

        document.getElementById('meal-summary-lunch').textContent = meals.lunch || '-';

        document.getElementById('meal-summary-dinner').textContent = meals.dinner || '-';

    }

    function renderFoodRecommendations() {

        const goal = document.getElementById('food-goal-select').value;

        const grid = document.getElementById('food-recommendations-grid');

        grid.innerHTML = '';

        const recommendations = {

            fokus: \[

                { title: 'Oatmeal & Pisang', desc: 'Kaya karbohidrat kompleks & kalium untuk daya ingat konsisten.', badge: 'Sarapan' },

                { title: 'Ikan Telur & Alpukat', desc: 'Kandungan Omega-3 & lemak sehat menunjang kerja otak.', badge: 'Makan Siang' },

                { title: 'Kacang Almond / Walnuts', desc: 'Camilan sehat pelindung sel syaraf saat belajar.', badge: 'Camilan' }

            \],

            energi: \[

                { title: 'Dada Ayam & Nasi Merah', desc: 'Tinggi protein murni untuk pembentukan otot & pemulihan lari.', badge: 'Makan Siang' },

                { title: 'Roti Gandum & Selai Kacang', desc: 'Energi cepat terserap sebelum olahraga atau lari.', badge: 'Pre-Workout' },

                { title: 'Susu UHT / Isotonik Alami', desc: 'Mengganti cairan tubuh & elektrolit pasca olahraga.', badge: 'Minuman' }

            \],

            diet: \[

                { title: 'Salad Sayur & Dada Ayam', desc: 'Rendah kalori, kaya serat untuk kenyang lebih lama.', badge: 'Makan Siang' },

                { title: 'Sup Sayuran & Tahu/Tempe', desc: 'Hangat, bergizi, dan menjaga lingkar pinggang seimbang.', badge: 'Makan Malam' },

                { title: 'Buah Apel / Buah Naga', desc: 'Metabolisme lancar dan kaya antioksidan alami.', badge: 'Camilan' }

            \]

        };

        (recommendations\[goal\] || \[\]).forEach(item => {

            const card = document.createElement('div');

            card.className = 'p-4 rounded-xl border border-slate-200/80 dark:border-slate-800 bg-white/60 dark:bg-slate-800/50 space-y-2';

            card.innerHTML = \`

                <span class="text-\[10px\] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">\${item.badge}</span>

                <h4 class="font-bold text-sm">\${item.title}</h4>

                <p class="text-xs text-slate-500">\${item.desc}</p>

            \`;

            grid.appendChild(card);

        });

    }

    function toggleRunTimer() {

        if (isRunning) {

            clearInterval(runTimerInterval);

            isRunning = false;

            document.getElementById('run-btn-text').textContent = 'Lanjutkan';

            document.getElementById('run-btn-icon').className = 'fa-solid fa-play';

        } else {

            isRunning = true;

            document.getElementById('run-btn-text').textContent = 'Jeda';

            document.getElementById('run-btn-icon').className = 'fa-solid fa-pause';

            runTimerInterval = setInterval(() => {

                runSeconds++;

                updateRunTimerDisplay();

            }, 1000);

        }

    }

    function resetRunTimer() {

        clearInterval(runTimerInterval);

        isRunning = false;

        runSeconds = 0;

        document.getElementById('run-btn-text').textContent = 'Mulai Lari';

        document.getElementById('run-btn-icon').className = 'fa-solid fa-play';

        updateRunTimerDisplay();

    }

    function updateRunTimerDisplay() {

        const h = String(Math.floor(runSeconds / 3600)).padStart(2, '0');

        const m = String(Math.floor((runSeconds % 3600) / 60)).padStart(2, '0');

        const s = String(runSeconds % 60).padStart(2, '0');

        document.getElementById('run-timer-display').textContent = \`\${h}:${m}:${s}\`;

        const distanceKm = ((runSeconds / 3600) \* 8.5).toFixed(2);

        const calories = Math.round(distanceKm \* 60);

        document.getElementById('run-distance-est').textContent = \`\${distanceKm} km\`;

        document.getElementById('run-calories-est').textContent = \`\${calories} kcal\`;

    }

    function saveRunLog() {

        if (runSeconds < 10) {

            showToast("Sesi lari terlalu pendek untuk disimpan.");

            return;

        }

        const distanceKm = ((runSeconds / 3600) \* 8.5).toFixed(2);

        const entry = {

            date: selectedDate,

            durationSec: runSeconds,

            distance: distanceKm

        };

        workoutHistory.unshift(entry);

        localStorage.setItem('rutiniti_workouts', JSON.stringify(workoutHistory));

        renderWorkoutHistory();

        resetRunTimer();

        showToast("Sesi lari berhasil disimpan!");

    }

    function renderWorkoutHistory() {

        const list = document.getElementById('workout-history-list');

        list.innerHTML = '';

        document.getElementById('stat-workout-done').textContent = \`\${workoutHistory.length} Kali\`;

        if (workoutHistory.length === 0) {

            list.innerHTML = '<p class="text-xs text-slate-400">Belum ada riwayat lari.</p>';

            return;

        }

        workoutHistory.slice(0, 3).forEach(w => {

            const item = document.createElement('div');

            item.className = 'flex justify-between items-center p-2 rounded-lg bg-slate-100/70 dark:bg-slate-800/50';

            item.innerHTML = \`

                <span><i class="fa-solid fa-running mr-1 text-amber-500"></i> Lari \${w.distance} km</span>

                <span class="text-\[11px\] text-slate-400">\${w.date}</span>

            \`;

            list.appendChild(item);

        });

    }

    document.getElementById('sleep-form').addEventListener('submit', (e) => {

        e.preventDefault();

        const start = document.getElementById('sleep-start-time').value;

        const end = document.getElementById('sleep-end-time').value;

        const quality = document.getElementById('sleep-quality').value;

        if (!start || !end) return;

        const \[sH, sM\] = start.split(':').map(Number);

        const \[eH, eM\] = end.split(':').map(Number);

        let diffMinutes = (eH \* 60 + eM) - (sH \* 60 + sM);

        if (diffMinutes < 0) diffMinutes += 24 \* 60;

        const hours = (diffMinutes / 60).toFixed(1);

        let status = 'Ideal (Cukup)';

        if (hours < 7) status = 'Kurang Tidur';

        if (hours > 9) status = 'Lebih dari Cukup';

        sleepData = { duration: hours, quality, status };

        localStorage.setItem('rutiniti_sleep\_' + selectedDate, JSON.stringify(sleepData));

        updateSleepUI();

        showToast("Data tidur disimpan!");

    });

    function updateSleepUI() {

        document.getElementById('sleep-duration-val').textContent = \`\${sleepData.duration || 0} Jam\`;

        document.getElementById('sleep-status-tag').textContent = sleepData.status || 'Belum Dicatat';

        document.getElementById('sleep-quality-tag').textContent = sleepData.quality || '-';

    }

    function setupEventListeners() {

        document.getElementById('theme-toggle').addEventListener('click', () => {

            document.documentElement.classList.toggle('dark');

            localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');

        });

        document.getElementById('date-picker').addEventListener('change', (e) => {

            selectedDate = e.target.value;

            updateDateHeaderDisplay();

            loadLocalData();

            renderRoutines();

            updateStatistics();

        });

        document.querySelectorAll('#filter-tabs .filter-btn').forEach(btn => {

            btn.addEventListener('click', () => {

                document.querySelectorAll('#filter-tabs .filter-btn').forEach(b => {

                    b.classList.remove('bg-emerald-600', 'text-white');

                    b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');

                });

                btn.classList.add('bg-emerald-600', 'text-white');

                activeFilter = btn.dataset.filter;

                renderRoutines();

            });

        });

        document.getElementById('btn-open-add-modal').addEventListener('click', openAddModal);

        document.getElementById('routine-form').addEventListener('submit', (e) => {

            e.preventDefault();

            saveRoutineFromForm();

        });

        document.getElementById('btn-request-notif').addEventListener('click', requestNotificationPermission);

    }

    function requestNotificationPermission() {

        if ('Notification' in window) {

            Notification.requestPermission().then(permission => {

                if (permission === 'granted') {

                    document.getElementById('notif-status-text').textContent = 'Notifikasi Aktif';

                    showToast("Notifikasi browser berhasil diaktifkan!");

                }

            });

        } else {

            showToast("Browser tidak mendukung notifikasi web.");

        }

    }

    function toggleRoutineStatus(id) {

        if (!logs\[selectedDate\]) logs\[selectedDate\] = {};

        logs\[selectedDate\]\[id\] = !logs\[selectedDate\]\[id\];

        saveLogs();

        renderRoutines();

        updateStatistics();

        checkNotificationsAndAlerts();

    }

    function openAddModal() {

        document.getElementById('routine-form').reset();

        document.getElementById('form-routine-id').value = '';

        document.getElementById('routine-modal').classList.remove('hidden');

    }

    function closeModal() {

        document.getElementById('routine-modal').classList.add('hidden');

    }

    function saveRoutineFromForm() {

        const title = document.getElementById('form-title').value.trim();

        const category = document.getElementById('form-category').value;

        const time = document.getElementById('form-time').value;

        const duration = parseInt(document.getElementById('form-duration').value) || 0;

        const newRoutine = {

            id: Date.now().toString(),

            title,

            category,

            time,

            duration

        };

        routines.push(newRoutine);

        saveRoutines();

        closeModal();

        renderRoutines();

        updateStatistics();

        showToast("Kegiatan baru berhasil disimpan!");

    }

    function deleteRoutine(id) {

        routines = routines.filter(r => r.id !== id);

        saveRoutines();

        renderRoutines();

        updateStatistics();

        showToast("Kegiatan telah dihapus.");

    }

    function openTimerModal(id) {

        const routine = routines.find(r => r.id === id);

        if (!routine) return;

        activeTimerRoutineId = id;

        document.getElementById('timer-routine-title').textContent = routine.title;

        timerSecondsRemaining = (routine.duration || 25) \* 60;

        updateTimerDisplay();

        document.getElementById('timer-modal').classList.remove('hidden');

    }

    function closeTimerModal() {

        clearInterval(timerInterval);

        isTimerRunning = false;

        document.getElementById('timer-modal').classList.add('hidden');

    }

    function toggleTimer() {

        if (isTimerRunning) {

            clearInterval(timerInterval);

            isTimerRunning = false;

            document.getElementById('timer-icon').className = 'fa-solid fa-play ml-1';

        } else {

            isTimerRunning = true;

            document.getElementById('timer-icon').className = 'fa-solid fa-pause';

            timerInterval = setInterval(() => {

                if (timerSecondsRemaining > 0) {

                    timerSecondsRemaining--;

                    updateTimerDisplay();
